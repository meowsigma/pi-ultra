{
  "name": "pi-ultra",
  "version": "0.1.0",
  "description": "Configurable parallel worker waves for Pi: /ultra launches bounded implementation lanes, binds models via named agents, and keeps the manager as auditor.",
  "keywords": [
    "pi-package",
    "pi",
    "subagents",
    "prompt-template"
  ],
  "license": "MIT",
  "type": "module",
  "files": [
    "extensions",
    "agents",
    "prompts",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "pack:check": "npm pack --dry-run"
  },
  "pi": {
    "extensions": [
      "./extensions"
    ],
    "subagents": {
      "agents": [
        "./agents"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meowsigma/pi-ultra.git"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.84.0",
    "pi-subagents": ">=0.54.0"
  },
  "dependencies": {
    "@narumitw/pi-tui-kit": "^0.57.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@earendil-works/pi-tui": "0.84.2",
    "@types/node": "^26.2.0",
    "pi-subagents": "0.54.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
