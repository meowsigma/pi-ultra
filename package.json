{
  "name": "pi-ultra",
  "version": "0.4.0",
  "description": "Session-wide, permit-governed Pi worker waves with the active model as manager and final reviewer.",
  "keywords": [
    "pi-package",
    "pi",
    "subagents"
  ],
  "license": "MIT",
  "type": "module",
  "files": [
    "extensions",
    "agents",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "pack:check": "npm pack --dry-run",
    "smoke:packed": "node tests/packed-runtime-smoke.mjs"
  },
  "pi": {
    "extensions": [
      "./extensions"
    ],
    "subagents": {
      "agents": [
        "./agents"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meowsigma/pi-ultra.git"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.84.0",
    "pi-subagents": "0.56.0-ultra.0",
    "typebox": "*"
  },
  "dependencies": {
    "@narumitw/pi-tui-kit": "^0.57.0",
    "pi-subagents": "https://github.com/meowsigma/pi-subagents/archive/4ecb7f7cbc4177e7e7f8bfc396222410618e097f.tar.gz"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@earendil-works/pi-tui": "0.84.2",
    "@types/node": "^26.2.0",
    "tsx": "^4.20.0",
    "typebox": "1.3.7",
    "typescript": "^5.9.0"
  },
  "bundledDependencies": [
    "@narumitw/pi-tui-kit",
    "pi-subagents"
  ]
}
